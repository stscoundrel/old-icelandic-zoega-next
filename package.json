    "old-norse-alphabet-sort": "^1.1.13",
    "prettier": "3.9.9",
    "react-test-renderer": "19.3.0",
    "spyrjari": "^1.0.4",
    "typescript": "^5.9.3",
    "volva": "^2.0.5",
    "@types/react-dom": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0"
  }
