    "old-icelandic-zoega-abbreviations": "^1.0.3",
    "old-norse-alphabet": "^1.2.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reset-css": "^5.0.2",
    "riimut": "^0.9.1",
    "sass": "^1.105.1",
    "scandinavian-dictionary-crosslinker": "^0.7.0",
    "serwist": "^9.5.13",
